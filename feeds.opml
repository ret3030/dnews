<?xml version="1.0" encoding="UTF-8"?>
<!--
  dnews feed list. Each folder becomes a tab; feeds inside it are fetched on start and Ctrl+R.
  priority="high" or "low" weighs an outlet in the Briefing (default: normal).
-->
<opml version="2.0">
  <head>
    <title>dnews feeds</title>
  </head>
  <body>
    <outline text="World">
      <outline text="BBC World" type="rss" priority="high" xmlUrl="https://feeds.bbci.co.uk/news/world/rss.xml"/>
      <outline text="Guardian World" type="rss" xmlUrl="https://www.theguardian.com/world/rss"/>
      <outline text="Al Jazeera" type="rss" xmlUrl="https://www.aljazeera.com/xml/rss/all.xml"/>
      <outline text="DW World" type="rss" xmlUrl="https://rss.dw.com/xml/rss-en-world"/>
      <outline text="France 24" type="rss" xmlUrl="https://www.france24.com/en/rss"/>
      <outline text="NPR World" type="rss" xmlUrl="https://feeds.npr.org/1004/rss.xml"/>
      <outline text="Politico Europe" type="rss" xmlUrl="https://www.politico.eu/feed/"/>
    </outline>
    <outline text="Business">
      <outline text="Guardian Business" type="rss" xmlUrl="https://www.theguardian.com/uk/business/rss"/>
      <outline text="Liberty Street Economics" type="rss" xmlUrl="https://libertystreeteconomics.newyorkfed.org/feed/"/>
    </outline>
    <outline text="Science &amp; Tech">
      <outline text="Nature" type="rss" xmlUrl="https://www.nature.com/nature.rss"/>
      <outline text="Ars Technica" type="rss" xmlUrl="https://feeds.arstechnica.com/arstechnica/index"/>
      <outline text="Hacker News" type="rss" priority="low" xmlUrl="https://news.ycombinator.com/rss"/>
    </outline>
  </body>
</opml>
